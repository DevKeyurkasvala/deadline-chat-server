# Local only. Render sets PORT automatically — do not hardcode 3015 in production.
CHAT_PORT=3015
# Set a unique value of at least 16 characters on each host.
# Never use CHANGE_ME_CHAT_SECRET as the live secret.
# Never put this value in browser JavaScript.
CHAT_INTERNAL_SECRET=CHANGE_ME_CHAT_SECRET
# Required in production. Comma-separated PHP site origins. Do not use * on Render.
CHAT_CORS_ORIGINS=http://localhost,http://127.0.0.1
# Production example (do not use these placeholder hosts as-is):
# CHAT_CORS_ORIGINS=https://app.example.com
# Optional. Restrict /internal/emit to the PHP host. Leave empty for secret-only.
# On Render, leave this empty (secret-only). The Node process sees the proxy IP,
# not the PHP host IP, so an allowlist usually blocks legitimate emits.
# CHAT_EMIT_ALLOW_IPS=127.0.0.1
# Render requires 0.0.0.0. This is the default if unset.
# CHAT_BIND=0.0.0.0
# Public browser Socket.IO URL. Use https:// when the website is HTTPS.
# Behind Apache/Nginx, this is usually the same HTTPS origin as the site.
# CHAT_SOCKET_PUBLIC_URL=https://chat.example.com
# CHAT_PUBLIC_URL=https://chat.example.com
# PHP -> Node emit URL. Keep this on the private network.
# CHAT_SOCKET_INTERNAL_URL=http://127.0.0.1:3015
# CHAT_INTERNAL_URL=http://127.0.0.1:3015
# Optional overrides (defaults live in includes/chat_settings.php).
# CHAT_RATE_LIMIT_MESSAGES=20
# CHAT_RATE_LIMIT_WINDOW_SECONDS=60
# CHAT_ROOM_TOKEN_TTL=7200
# CHAT_SOCKET_TOKEN_TTL=3600
# CHAT_EDIT_WINDOW_SECONDS=900
# CHAT_UPLOAD_MAX_BYTES=10485760
# CHAT_UPLOAD_MAX_COUNT=5
# CHAT_UPLOAD_MAX_TOTAL_BYTES=26214400
# CHAT_POLL_INTERVAL_MS=8000
# CHAT_CONVERSATION_PAGE_SIZE=50
